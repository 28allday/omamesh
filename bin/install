#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "Omamesh is built with makepkg. Install the build tools first:" >&2
  echo "  sudo pacman -S --needed base-devel git" >&2
  exit 1
fi

# makepkg installs what Omamesh needs before building it, so nothing is
# compiled here: on a new machine the Qt libraries are not there yet.
cd "$PKGBUILD_DIR"
exec makepkg -fsi "$@"
